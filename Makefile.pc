# Build the PC version for testing:  make -f Makefile.pc
CC ?= gcc
CFLAGS ?= -O2 -g -Wall -Wextra -std=c99 -D_DEFAULT_SOURCE
SRC = src/parser.c src/compiler.c src/vm.c src/natives.c src/disasm.c src/media.c pc/main_pc.c pc/platform_pc.c

minisharp: $(SRC) src/ms.h src/ast.h src/platform.h src/media.h
	$(CC) $(CFLAGS) -o $@ $(SRC) -lm

test: minisharp
	sh ./tests/run_tests.sh

clean:
	rm -f minisharp

.PHONY: test clean
